# Frontend build artifacts/deps
apps/web/node_modules/
apps/web/dist/
apps/web/.angular/

# Exclude unrelated projects from frontend root-context build
backend/mcp/
apps/desktop/

# PocketBase data: only seed.json is needed for frontend build
backend/pocketbase/pb_data/*
!backend/pocketbase/pb_data/seed.json

# Local/generated files
.git/
.DS_Store

# Secrets never belong in a build context
.env
.env.*
!.env.example
